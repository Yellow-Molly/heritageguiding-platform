                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "RwQUJ",
                  "name": "bioSection",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "MG10e",
                      "name": "bioHead",
                      "fill": "$--color-primary",
                      "content": "About Anna",
                      "fontFamily": "Playfair Display",
                      "fontSize": 32,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "vt3HG",
                      "name": "bioP1",
                      "fill": "$--color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Born and raised in Stockholm, Anna Lindström has spent her life immersed in the rich history and culture of Sweden's capital. Her deep passion for storytelling and heritage led her to pursue a Master's degree in Art History from Stockholm University, where she specialized in Scandinavian medieval architecture.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "TdvMC",
                      "name": "bioP2",
                      "fill": "$--color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Since beginning her guiding career in 2015, Anna has welcomed thousands of visitors from around the world, sharing the hidden stories and fascinating details that make Stockholm truly unique. She specializes in the medieval quarter of Gamla Stan, bringing centuries-old cobblestone streets and ancient buildings to life with vivid narratives.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "FWCKY",
                      "name": "bioP3",
                      "fill": "$--color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An avid photographer and history enthusiast, Anna believes that the best tours are not just about dates and facts — they're about creating genuine connections between people and places. Her tours blend academic knowledge with personal anecdotes, ensuring every guest leaves with a deeper appreciation for Stockholm's extraordinary heritage.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "rectangle",
