                  "name": "storyTitle",
                  "fill": "$--color-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Created for Travelers\nWho Value Depth",
                  "lineHeight": 1.2,
                  "fontFamily": "Playfair Display",
                  "fontSize": 36,
                  "fontWeight": "600",
                  "letterSpacing": -0.5
                },
                {
                  "type": "text",
                  "id": "6c2h1",
                  "name": "storyBody",
                  "fill": "$--color-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Private Tours was created for travelers who value depth, trust, and personal connection over volume and speed. We offer private, expertly hosted experiences in Stockholm led exclusively by authorized professionals.\n\nEvery guide is carefully selected, every route curated. Our tours combine historical expertise with hands-on activities like Swedish culinary culture — making time in Stockholm feel meaningful, effortless, and personal.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "RpVj9",
                  "name": "quoteFrame",
                  "width": "fill_container",
                  "stroke": {
                    "align": "inside",
                    "thickness": {
                      "left": 4
                    },
                    "fill": "$--color-secondary"
                  },
                  "padding": [
                    24,
                    32
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "oknMF",
                      "name": "quoteText",
                      "fill": "$--color-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“Our guests are not looking for more options. They are looking for the right one.”",
                      "lineHeight": 1.4,
                      "fontFamily": "Playfair Display",
                      "fontSize": 22,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
