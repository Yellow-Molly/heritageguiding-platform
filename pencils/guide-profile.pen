              "fontSize": 22,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "9twln",
              "fill": "$--color-text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Anders Boysen is a guide driven by a genuinely personal passion for understanding context and tracing the developmental arcs of history. He guides in English, German and French, and works primarily with international visitors who want more than the surface view.",
              "lineHeight": 1.65,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "TMVFz",
              "fill": "$--color-text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "What drives Anders is not the delivery of facts alone — it is the moment when a guest suddenly sees a pattern, a connection, a new insight. That joy is his compass.",
              "lineHeight": 1.65,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
