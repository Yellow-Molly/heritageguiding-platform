                      "name": "bioP1",
                      "fill": "$--color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Anders Boysen is a guide driven by a genuinely personal passion for understanding context and tracing the developmental arcs of history. He guides in English, German and French, and works primarily with international visitors who want more than the surface view.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "normal"
