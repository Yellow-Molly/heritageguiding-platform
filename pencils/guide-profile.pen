              "fill": "$--color-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "When I manage to awaken the joy of discovery in my guests — that's when I'm satisfied.",
              "lineHeight": 1.5,
              "fontFamily": "Playfair Display",
              "fontSize": 17,
