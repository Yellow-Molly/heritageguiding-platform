              "fill": "$--color-text-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A graduate of Stockholm University's History Department, Anna specializes in medieval Scandinavian history and royal heritage. She is a certified member of the Swedish Guide Association.",
              "lineHeight": 1.7,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            }
