        {
          "type": "frame",
          "id": "z28VZ",
          "name": "bio",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 32,
          "padding": [
            64,
            200
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "TtCxx",
              "fill": "$--color-primary",
              "content": "About Anna",
              "fontFamily": "$--font-heading",
              "fontSize": 36,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "RLtHg",
              "fill": "$--color-text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Anna Lindström is a certified Stockholm guide with over a decade of experience bringing the city's rich history to life. With a Master's degree in Art History from Stockholm University, she combines academic rigor with passionate storytelling to create unforgettable walking tours through Stockholm's most iconic neighborhoods.",
              "lineHeight": 1.75,
              "fontFamily": "$--font-body",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "ap5K7",
              "name": "quoteFrame",
              "width": "fill_container",
              "fill": "$--color-background-alt",
              "cornerRadius": "$--radius-md",
              "stroke": {
                "align": "inside",
                "thickness": {
                  "left": 4
                },
                "fill": "$--color-secondary"
              },
              "layout": "vertical",
              "gap": 16,
              "padding": [
                32,
                48
              ],
              "children": [
                {
                  "type": "text",
                  "id": "gYInQ",
                  "fill": "$--color-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "\"Every cobblestone in Gamla Stan has a story to tell. My mission is to make those stones speak — to transport you back in time and help you see Stockholm through the eyes of kings, merchants, and everyday people who shaped this beautiful city.\"",
                  "lineHeight": 1.65,
                  "fontFamily": "$--font-heading",
                  "fontSize": 18,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "X3uRB",
                  "fill": "$--color-text-muted",
                  "content": "— Anna Lindström",
                  "fontFamily": "$--font-body",
                  "fontSize": 14,
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "text",
              "id": "BfBgL",
              "fill": "$--color-text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Born and raised in Stockholm, Anna's deep connection to the city is evident in every tour. She specializes in medieval history, royal heritage, and architectural traditions, offering perspectives that go far beyond typical guidebook information.",
              "lineHeight": 1.75,
              "fontFamily": "$--font-body",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
