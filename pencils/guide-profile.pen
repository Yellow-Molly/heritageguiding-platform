              "gap": 24,
              "children": [
                {
                  "type": "text",
                  "id": "SJ5Jg",
                  "fill": "$--color-primary",
                  "content": "About Anna",
                  "lineHeight": 1.1,
                  "fontFamily": "Playfair Display",
                  "fontSize": 42,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "slEi2",
                  "fill": "$--color-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "With over 15 years of experience guiding visitors through Stockholm's rich tapestry of history, Anna Lindström has become one of the city's most sought-after heritage tour guides. Her passion for storytelling transforms every cobblestone street and centuries-old building into a vivid chapter of Swedish history.",
                  "lineHeight": 1.75,
                  "fontFamily": "Inter",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Bl8dL",
                  "fill": "$--color-text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A graduate of Stockholm University's History Department, Anna specializes in medieval Scandinavian history and royal heritage. She is a certified member of the Swedish Guide Association and has been featured in Condé Nast Traveller and The Guardian's travel section.",
                  "lineHeight": 1.75,
                  "fontFamily": "Inter",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
