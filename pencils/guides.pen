                      "name": "bio6",
                      "fill": "$--color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "With an MA in Archaeology and years of fieldwork at Birka, Henrik has traced paths to Viking trading posts in vast detail. His tours are epic voyages through time, connecting ancient Norse history to modern Stockholm.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
