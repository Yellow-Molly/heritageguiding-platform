                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"The Vikings weren't just raiders — they were traders, poets, and explorers. I take you on their journeys.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "Playfair Display",
                      "fontSize": 16,
                      "fontWeight": "normal",
