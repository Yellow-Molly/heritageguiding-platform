                      "name": "quote4",
                      "fill": "$--color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"History isn't something you read — it's something you walk through. I help people feel the weight of centuries beneath their feet.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "Playfair Display",
                      "fontSize": 16,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
