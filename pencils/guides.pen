                      "fill": "$--color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"Food is culture served on a plate. Through Swedish fika and seasonal flavors, I share the soul of our traditions.\"",
                      "lineHeight": 1.6,
