                      "name": "quote2",
                      "fill": "$--color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"Architecture is the autobiography of a city. Stockholm's buildings tell a story of ambition, beauty, and resilience.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "Playfair Display",
                      "fontSize": 16,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
