                      "name": "quote1",
                      "fill": "$--color-text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"Every cobblestone in Gamla Stan has a story. My job is to make sure you hear the ones that matter.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "Playfair Display",
                      "fontSize": 16,
                      "fontWeight": "normal",
