                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "O5Rfq",
                      "name": "expBody1",
                      "fill": "$--color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Discover the enchanting heart of Stockholm on this intimate walking tour through Gamla Stan, the city's beautifully preserved medieval old town. Your certified guide will bring centuries of history to life as you wander through narrow cobblestone streets, past colorful merchant houses, and into hidden courtyards that most visitors never find.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "G0x4v",
                      "name": "expBody2",
                      "fill": "$--color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "From the grandeur of the Royal Palace to the charm of Stortorget — Scandinavia's oldest square — every corner tells a story. Learn about Viking origins, medieval trade routes, the Stockholm Bloodbath, and the Nobel Prize legacy that continues to shape this remarkable city.",
                      "lineHeight": 1.7,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
