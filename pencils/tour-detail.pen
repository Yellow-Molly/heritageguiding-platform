            {
              "type": "text",
              "id": "Cc6Dp",
              "name": "mexpBody",
              "fill": "$--color-text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Discover the enchanting heart of Stockholm on this intimate walking tour through Gamla Stan, the city's beautifully preserved medieval old town. Your certified guide will bring centuries of history to life as you wander through narrow cobblestone streets, past colorful merchant houses, and into hidden courtyards that most visitors never find.\n\nFrom the grandeur of the Royal Palace to the charm of Stortorget — Scandinavia's oldest square — every corner tells a story.",
              "lineHeight": 1.7,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
