                      "fontWeight": "600",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "pw6Ro",
                      "name": "expTitle",
                      "fill": "$--color-primary",
                      "content": "Discover Medieval Stockholm",
                      "fontFamily": "Playfair Display",
                      "fontSize": 36,
