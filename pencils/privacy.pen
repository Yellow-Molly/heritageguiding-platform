                        {
                          "type": "frame",
                          "id": "5KPXU",
                          "name": "PrivacyProse",
                          "width": "fill_container",
                          "fill": "#FFFFFF00",
                          "layout": "vertical",
                          "gap": 48,
                          "children": [
                            {
                              "type": "frame",
                              "id": "olbNJ",
                              "name": "Sec02 Definitions",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "k9sX2",
                                  "name": "h2_2",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "02  Definitions",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "8VMTD",
                                  "name": "div2",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "qnKEi",
                                  "name": "p2a",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "\"Personal data\", \"processing\", \"controller\", \"processor\", and \"data subject\" carry the meanings set out in Article 4 of the GDPR. Where capitalised in this notice, those terms apply with the same scope.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "eSwii",
                              "name": "Sec03 PersonalData",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "UXqON",
                                  "name": "h2_3",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "03  Personal Data Collected",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "RXNUw",
                                  "name": "div3",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "zoOXD",
                                  "name": "p3a",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We collect data you provide directly when booking a tour, creating an account, or contacting us — name, email, phone number, billing address, language preference, dietary or accessibility requirements where you choose to share them, and the content of messages you send.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "6DdEN",
                                  "name": "p3b",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We also collect technical data automatically — IP address, device type, browser, referrer, pages viewed, and interaction events — through privacy-respecting analytics. Payment card details are entered directly on Stripe's hosted checkout and are never stored on our servers.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "S4Xgi",
                              "name": "Sec06 DataSharing",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "QQ3Zc",
                                  "name": "h2_6",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "06  Data Sharing",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "od5e7",
                                  "name": "div6",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "aPyXa",
                                  "name": "p6a",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We share personal data only with the sub-processors listed in Section 05, and only to the extent necessary to deliver the service. We do not sell personal data and we do not share it for cross-context behavioural advertising.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "ak9iS",
                                  "name": "p6b",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We may disclose data to public authorities when compelled by binding legal process. Where lawful, we will notify you of any such request before disclosure.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "JLJ1P",
                              "name": "Sec07 Transfers",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "R08G2",
                                  "name": "h2_7",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "07  International Transfers",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "kbeIf",
                                  "name": "div7",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "eBxzu",
                                  "name": "p7a",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Where data is transferred outside the European Economic Area, we rely on the European Commission's Standard Contractual Clauses (SCCs, 2021/914) or, for transfers to the United States, the EU-U.S. Data Privacy Framework.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "frame",
                                  "id": "ukRJa",
                                  "name": "quote7",
                                  "width": "fill_container",
                                  "fill": "#FFFFFF00",
                                  "stroke": {
                                    "align": "inside",
                                    "thickness": {
                                      "left": 4
                                    },
                                    "fill": "$color-secondary"
                                  },
                                  "layout": "vertical",
                                  "gap": 8,
                                  "padding": [
                                    16,
                                    24
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "jBga2",
                                      "name": "qt7",
                                      "fill": "$color-text",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "A copy of the safeguards used for any specific transfer is available on request — write to privacy@heritageguidingsweden.com and reference the relevant sub-processor.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Playfair Display",
                                      "fontSize": 18,
                                      "fontWeight": "normal",
                                      "fontStyle": "italic"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "qXisL",
                              "name": "Sec10 Cookies",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "bZNs8",
                                  "name": "h2_10",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "10  Cookies & Tracking",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "KnFJN",
                                  "name": "div10",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "p8STk",
                                  "name": "p10a",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We use a small number of strictly necessary cookies to keep you signed in and to remember your language preference. Optional analytics cookies are loaded only after you grant consent through the banner that appears on your first visit.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "c7mcQ",
                                  "name": "p10b",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "You can withdraw consent at any time from the Cookie Settings link in the footer. Withdrawing consent does not affect the lawfulness of processing carried out before the withdrawal.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "bi7bM",
                              "name": "Sec11 Children",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "sWZHm",
                                  "name": "h2_11",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "11  Children",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "EEQ3w",
                                  "name": "div11",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "OK3Zl",
                                  "name": "p11",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Our service is intended for adults. We do not knowingly collect personal data from children under 16. Where a parent or guardian books a tour that includes a minor, we collect only the minor's first name and any safety-relevant accessibility information, and only with the booking adult's explicit consent.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "ITJJP",
                              "name": "Sec12 Automated",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "7gyBu",
                                  "name": "h2_12",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "12  Automated Decisions",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "yygRR",
                                  "name": "div12",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "tmyi4",
                                  "name": "p12",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We do not make decisions about you that are based solely on automated processing and that produce legal or similarly significant effects. Stripe's fraud detection may decline a payment automatically; in that case you will be redirected to a human review path on request.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "mGR0V",
                              "name": "Sec13 Security",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "UzMxz",
                                  "name": "h2_13",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "13  Security",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "mamSG",
                                  "name": "div13",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "cbC4H",
                                  "name": "p13",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "All traffic is encrypted in transit with TLS 1.3. Production data is encrypted at rest. Access to systems is restricted by role and protected by single-sign-on with mandatory multi-factor authentication. We test our backups quarterly and maintain a documented incident-response plan with a 72-hour notification target to the IMY.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "TPGkg",
                              "name": "Sec14 Changes",
                              "width": "fill_container",
                              "fill": "#FFFFFF00",
                              "layout": "vertical",
                              "gap": 16,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "Vc23A",
                                  "name": "h2_14",
                                  "fill": "$color-primary",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "14  Changes to this Policy",
                                  "lineHeight": 1.2,
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 32,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "rectangle",
                                  "id": "0UUjo",
                                  "name": "div14",
                                  "fill": "$color-secondary",
                                  "width": 32,
                                  "height": 2
                                },
                                {
                                  "type": "text",
                                  "id": "lG4ne",
                                  "name": "p14",
                                  "fill": "$color-text",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We review this notice at least annually and whenever we add a new sub-processor or change a legal basis. Material changes are announced by email to active customers at least thirty days before they take effect; the revision history is preserved at the foot of this page.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
