# App
NODE_ENV=development
NEXT_PUBLIC_URL=http://localhost:3000

# Pre-launch holding gate (production apex `privatetours.se` only). Fail-safe:
# the live domain stays on the "coming soon" page UNLESS this is exactly 'false'.
# Leave unset everywhere except production; flip to 'false' to GO LIVE (then
# redeploy). Host-scoped, so local/preview/staging are never gated.
COMING_SOON=

# Database (Supabase PostgreSQL)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL=postgresql://user:password@localhost:5432/heritageguiding

# Payload CMS
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=your-secret-key-minimum-32-characters-change-me

# Vercel Blob Storage (for media uploads)
# Get from Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=

# Bokun Booking API (Phase 8.1)
# Get from Bokun Dashboard > API Settings
BOKUN_API_KEY=your-bokun-access-key
BOKUN_SECRET_KEY=your-bokun-secret-key
# Webhook secret for signature verification
BOKUN_WEBHOOK_SECRET=your-webhook-secret-for-validation
# Booking channel UUID (public - exposed to browser for widget)
NEXT_PUBLIC_BOKUN_UUID=your-booking-channel-uuid
# Primary locale for outbound text sync (single value; CMS localized fields are
# flattened to this language when pushed to Bokun). Valid: en | sv | de.
# Defaults to `en` if unset.
BOKUN_SYNC_LOCALE=en
# Extras push (Phase-2) global kill switch. When `false` (default), CMS
# `optionalAddOns` are NEVER pushed to Bokun regardless of per-tour baseline.
# Flip to `true` only after staging canary on a baselined tour confirms the
# pipeline works end-to-end. See plans/260525-1417-bokun-extras-push-sync/.
BOKUN_EXTRAS_PUSH_ENABLED=false

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=bookings@privatetours.se

# OpenAI API (for semantic search embeddings)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# i18n
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=sv,en,de

# Contact (overrides defaults in apps/web/lib/contact-constants.ts)
# Used by footer, contact page, schema.org JSON-LD
NEXT_PUBLIC_CONTACT_PHONE=+46 72 441 19 01
NEXT_PUBLIC_CONTACT_EMAIL=info@privatetours.se

# WhatsApp floating button (digits only — no `+`, no spaces; per wa.me spec)
# Falls back to Payload CMS site-settings.whatsappNumber if unset
WHATSAPP_NUMBER=46724411901

# Sentry error tracking (optional — activates only when DSN set AND
# VERCEL_ENV=production). Set both DSNs from your Sentry project.
# https://docs.sentry.io/platforms/javascript/guides/nextjs/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — required for source-map upload (run in CI).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional release tag (recommend Vercel commit SHA via CI).
SENTRY_RELEASE=
